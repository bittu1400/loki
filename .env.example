# ============================================================
# Multi-Model Novel Writing Automation — environment template
# Copy to .env and fill in. NEVER commit .env (gitignored).
# All three providers are free-tier. No paid keys required.
# ============================================================

# ---- Google Gemini (AI Studio) -----------------------------
# Get key: https://aistudio.google.com/apikey
# Free tier. NOTE: Google may use free-tier submissions to
# improve products. See threat-model.md.
GEMINI_API_KEY=

# ---- OpenRouter --------------------------------------------
# Get key: https://openrouter.ai/keys
# Free model pool (":free" slugs). Shared contention, frequent 429s.
# Many free models log/train on input. See threat-model.md.
OPENROUTER_API_KEY=

# Optional but recommended by OpenRouter for free-tier ranking/limits.
# Any URL identifying this project is fine.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=novel-engine

# ---- Groq ---------------------------------------------------
# Get key: https://console.groq.com/keys
# Free tier. Fast, but tight TPM/RPM ceilings.
GROQ_API_KEY=

# ---- Mistral (La Plateforme) --------------------------------
# Get key: https://console.mistral.ai/api-keys
# Free "Experiment" tier: all models incl. Mistral Large, ~1 req/s,
# ~1B tokens/month. Phone verification; no card.
# NOTE: variable name uses underscores — MISTRAL_API-KEY silently fails.
MISTRAL_API_KEY=

# ---- NVIDIA NIM ---------------------------------------------
# Get key: https://build.nvidia.com/settings/api-keys
# Free tier (~40 RPM). Hosts minimax-m3 and llama-3.3-70b directly —
# our stable fallback lane outside OpenRouter's shared free pool.
NVIDIA_API_KEY=

# ---- Cohere --------------------------------------------------
# Get key: https://dashboard.cohere.com/api-keys
# Free trial key (~1,000 calls/month). Command A+ emits a thinking block;
# the provider layer must send thinking disabled for drafting calls.
COHERE_API_KEY=

# ---- Z.ai (Zhipu GLM international) -------------------------
# Get key: https://z.ai / https://open.bigmodel.cn
# Only GLM-Flash-tier models are free; larger GLMs require balance.
GLM_API_KEY=

# ============================================================
# Publishing (Phase 7+ / deferred — leave blank for now)
# ============================================================

# Shared secret between the GitHub Action and the Cousins
# POST /api/publish-chapter endpoint. Bearer token.
COUSINS_PUBLISH_KEY=

# Base URL of the Cousins deployment, no trailing slash.
COUSINS_BASE_URL=

# ============================================================
# Runtime behaviour (optional overrides — defaults live in
# config/pipeline.yaml, not here)
# ============================================================

# Default book slug used when --book is omitted.
DEFAULT_BOOK_SLUG=

# Set to 1 to assemble prompts and print them WITHOUT spending
# any API call. Use this constantly while tuning.
DRY_RUN=0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
