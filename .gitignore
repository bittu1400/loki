# Secrets — never commit
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Session scratch
*.log
.DS_Store

# Vault — real manuscripts stay local (ADR-0004).
# Everything under vault/ is ignored EXCEPT the committed
# example-book fixture that tests and CI run against.
vault/*
!vault/example-book/
